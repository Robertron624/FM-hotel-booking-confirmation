---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header/Header.astro";
import WelcomeCard from "../components/WelcomeCard.astro";
import Receipt from "../components/Receipt.astro";
import AmenitiesCard from "../components/AmenitiesCard.astro";
import { amenitiesData } from "../amenitiesData";
---

<Layout>
  <Header />
  <main>
    <div class="welcome-text">
      <p class="subheading">BOOKING · CONFIRMED</p>
      <h1>Bienvenue, <span>Lucia.</span></h1>
    </div>
    <div class="main-buttons">
      <button class="print-receipt">Print Receipt</button>
      <button class="add-to-calendar"> Add to Calendar </button>
    </div>
    <div class="welcome-and-receipt">
      <div class="cards">
        <WelcomeCard />
        <img src="/images/illustration-sun.svg" alt="" aria-hidden="true" class="illustration-sun" />
        <Receipt />
      </div>
      <p class="hover-message">
        <img src="/images/icon-sparkle.svg" alt="" />
        <span> HOVER TO FAN </span>
        <img src="/images/icon-sparkle.svg" alt="" />
      </p>
    </div>
    <section class="amenities-list" aria-label="Amenities and stay details">
      {amenitiesData.map((amenity) => <AmenitiesCard {...amenity} />)}
    </section>
  </main>
</Layout>

<style lang="scss">
  @use "../styles/breakpoints" as bp;

  button,
  a  {
    &:hover {
      outline: 1px solid var(--terracotta-500);
    }
  }

  main {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1rem;
    font-family: var(--font-sans);

    .welcome-text {
      .subheading {
        font-size: 1rem;
        font-weight: 500;
        font-family: var(--font-mono);
        color: var(--neutral-600);
      }
      h1 {
        font-size: 3rem;
        font-weight: 400;
        margin-top: 0.5rem;
        font-family: var(--font-serif);
        span {
          color: var(--terracotta-500);
          font-style: italic;
        }
      }
    }

    .main-buttons {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
      flex-wrap: wrap;
      button {
        padding: 0.75rem 2rem;
        border-radius: 50px;
        font-size: 1rem;
        font-weight: 600;
        border-width: 2px;
        border-style: solid;
        transition:
          background-color 0.5s ease,
          color 0.5s ease;
      }

      .print-receipt {
        color: var(--neutral-700);
        border-color: var(--neutral-200);

        &:hover {
          background-color: var(--neutral-200);
        }
      }

      .add-to-calendar {
        background-color: var(--neutral-900);
        color: var(--neutral-100);

        &:hover {
          background-color: var(--neutral-700);
        }
      }
    }

    .welcome-and-receipt {
      .cards {
        position: relative;
        display: flex;
        justify-content: center;
        gap: 0.2rem;
        transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);

        @include bp.desktop {
          gap: 0.25rem;
          max-width: 60rem;
          margin-inline: auto;
        }

        .illustration-sun {
          position: absolute;
          top: 12.5rem;
          left: 47%;
          transform: translateX(-50%);
          width: 12rem;
          height: 12rem;
          z-index: 0;
          display: none;

          @include bp.desktop {
            display: block;
          }
        }
      }

      .hover-message {
        display: none;

        @include bp.desktop {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 0.5rem;
          margin-top: 1.5rem;
          font-family: var(--font-mono);
          font-size: 0.85rem;
          color: var(--neutral-600);
          opacity: 0.82;
          transform: translateY(0.2rem);
          transition:
            opacity 280ms ease,
            transform 280ms ease;
        }
      }

      &:hover {
        cursor: pointer;
        .cards {
          // Child components are style-scoped in Astro, so use :global to target their root classes.
          :global(.welcome-card) {
            transform: rotate(-5.4deg) translate(65px, 10px);
          }

          :global(.receipt) {
            transform: translateX(-7rem) rotate(5deg);
          }
        }
        .hover-message {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @include bp.desktop {
        margin-top: 2rem;
      }
    }

    .amenities-list {
      display: grid;
      gap: 1rem;
      margin-top: 1.5rem;

      @include bp.desktop {
        margin-top: 4.5rem;
      }
    }

    @include bp.desktop {
      min-height: 100svh;
      padding: 1.25rem 1.8rem 4rem 10rem;

      .welcome-text {
        display: inline-block;
      }

      .main-buttons {
        margin-top: 0;
        justify-content: flex-end;
      }

      .welcome-and-receipt {
        margin-bottom: auto;
      }

      .amenities-list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  }
</style>
