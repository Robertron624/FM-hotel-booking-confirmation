<div class="mobile-menu-overlay" data-mobile-menu-overlay>
	<aside
		id="mobile-menu-panel"
		class="mobile-menu-panel"
		role="dialog"
		aria-modal="true"
		aria-label="Mobile navigation menu"
	>
		<div class="menu-top-row">
			<a href="/" class="menu-logo-link" aria-label="Go to home">
				<img src="/images/logo.svg" alt="Maison Soleil" class="menu-logo" />
			</a>

			<button class="menu-close-button" type="button" data-mobile-menu-close aria-label="Close menu">
				<img src="/images/icon-close.svg" alt="" aria-hidden="true" />
			</button>
		</div>

		<hr class="menu-divider" />

		<nav aria-label="Mobile menu">
			<ul class="menu-list">
				<li>
					<a href="/your-stay" class="menu-item is-active">
						<span class="menu-item-left">
							<img src="/images/icon-bed.svg" alt="" aria-hidden="true" />
