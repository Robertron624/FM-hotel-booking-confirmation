			</ul>
		</nav>

		<section class="weather-card" aria-label="Today weather in Cassis">
			<p class="weather-caption">TODAY IN CASSIS</p>
			<p class="weather-temp">27&deg;</p>
			<p class="weather-detail">Sunny · light breeze</p>
			<span class="weather-sun" aria-hidden="true"></span>
		</section>

		<hr class="menu-divider menu-divider-bottom" />

