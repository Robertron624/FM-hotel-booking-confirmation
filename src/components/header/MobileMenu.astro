			<p>&copy; 2026 MAISON SOLEIL</p>
		</footer>
	</aside>
</div>

<script>
	if (document.body.dataset.mobileMenuInitialized !== "true") {
		document.body.dataset.mobileMenuInitialized = "true";

		const overlay = document.querySelector("[data-mobile-menu-overlay]");
		const panel = document.querySelector("#mobile-menu-panel");
		const closeButton = document.querySelector("[data-mobile-menu-close]");
		const trigger = document.querySelector("[data-mobile-menu-open]");
		const closeDurationMs = 300;

		if (overlay && panel && closeButton && trigger) {
			let closeFallbackTimeout: ReturnType<typeof window.setTimeout> | null = null;

			const openMenu = () => {
				overlay.classList.add("is-visible");
				requestAnimationFrame(() => {
					overlay.classList.add("is-open");
				});
				trigger.setAttribute("aria-expanded", "true");
				document.body.style.overflow = "hidden";
			};

			const closeMenu = () => {
				if (!overlay.classList.contains("is-open")) {
					return;
				}

				overlay.classList.remove("is-open");
				trigger.setAttribute("aria-expanded", "false");

				if (closeFallbackTimeout) {
					clearTimeout(closeFallbackTimeout);
				}

				closeFallbackTimeout = window.setTimeout(() => {
					overlay.classList.remove("is-visible");
					document.body.style.overflow = "";
					closeFallbackTimeout = null;
				}, closeDurationMs + 40);
			};

			panel.addEventListener("transitionend", (event) => {
				const transitionEvent = event as TransitionEvent;

				if (transitionEvent.propertyName !== "transform") {
					return;
				}

				if (!overlay.classList.contains("is-open")) {
					overlay.classList.remove("is-visible");
					document.body.style.overflow = "";

					if (closeFallbackTimeout) {
						clearTimeout(closeFallbackTimeout);
						closeFallbackTimeout = null;
					}
				}
			});

			trigger.addEventListener("click", openMenu);
			closeButton.addEventListener("click", closeMenu);

			overlay.addEventListener("click", (event) => {
				if (event.target === overlay) {
					closeMenu();
				}
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && overlay.classList.contains("is-open")) {
					closeMenu();
				}
			});
		}
	}
</script>

